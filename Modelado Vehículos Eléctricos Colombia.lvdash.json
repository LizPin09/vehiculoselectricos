{
  "datasets": [
    {
      "name": "clasificacion_muni",
      "displayName": "Clasificación Municipios por Adopción",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  gold_clasificacion_municipios_adopcion"
      ]
    },
    {
      "name": "proporcion_dep",
      "displayName": "Proporción Eléctricos por Departamento",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  gold_proporcion_electricos_departamento"
      ]
    },
    {
      "name": "kpis_modelos",
      "displayName": "KPIs Modelos Predictivos",
      "queryLines": [
        "SELECT\n",
        "  332901 AS Total_Electricos_Hibridos,\n",
        "  7.52 AS Proporcion_2026,\n",
        "  57.7 AS CAGR_Electricos,\n",
        "  9.5 AS Techo_Adopcion"
      ]
    },
    {
      "name": "parque_vs_elec",
      "displayName": "Parque Total vs Eléctricos por Año",
      "queryLines": [
        "SELECT\n",
        "  REGISTRO,\n",
        "  'Parque Total' AS Tipo,\n",
        "  TOTAL_PARQUE AS Valor\n",
        "FROM\n",
        "  gold_proporcion_electricos_anio\n",
        "UNION ALL\n",
        "SELECT\n",
        "  REGISTRO,\n",
        "  'Electricos/Hibridos' AS Tipo,\n",
        "  TOTAL_ELECTRICOS AS Valor\n",
        "FROM\n",
        "  gold_proporcion_electricos_anio"
      ]
    },
    {
      "name": "proporcion_anio",
      "displayName": "Proporción Eléctricos por Año",
      "queryLines": [
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  gold_proporcion_electricos_anio"
      ]
    },
    {
      "name": "top_deps_prop",
      "displayName": "Top Departamentos por Proporción",
      "queryLines": [
        "SELECT\n",
        "  DEPARTAMENTO,\n",
        "  ROUND(SUM(TOTAL_ELECTRICOS) / SUM(TOTAL_PARQUE) * 100, 2) AS Proporcion_Pct\n",
        "FROM\n",
        "  gold_proporcion_electricos_departamento\n",
        "GROUP BY\n",
        "  DEPARTAMENTO\n",
        "ORDER BY\n",
        "  Proporcion_Pct DESC"
      ]
    },
    {
      "name": "muni_lideres",
      "displayName": "Municipios Líderes en Adopción",
      "queryLines": [
        "SELECT\n",
        "  MUNICIPIO,\n",
        "  DEPARTAMENTO,\n",
        "  TOTAL_PARQUE,\n",
        "  TOTAL_ELECTRICOS,\n",
        "  PROPORCION_PORCENTAJE\n",
        "FROM\n",
        "  gold_clasificacion_municipios_adopcion\n",
        "WHERE\n",
        "  NIVEL_ADOPCION = 'Líder (≥10%)'\n",
        "ORDER BY\n",
        "  PROPORCION_PORCENTAJE DESC"
      ]
    },
    {
      "name": "top_muni_prop",
      "displayName": "Top 20 Municipios por Proporción",
      "queryLines": [
        "SELECT\n",
        "  MUNICIPIO,\n",
        "  DEPARTAMENTO,\n",
        "  TOTAL_PARQUE,\n",
        "  TOTAL_ELECTRICOS,\n",
        "  PROPORCION_PORCENTAJE\n",
        "FROM\n",
        "  gold_clasificacion_municipios_adopcion\n",
        "ORDER BY\n",
        "  PROPORCION_PORCENTAJE DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "name": "predicciones_ml",
      "displayName": "Predicciones ML Eléctricos",
      "queryLines": [
        "WITH params AS (\n",
        "  SELECT\n",
        "    9.51 AS L,\n",
        "    2024 AS t0,\n",
        "    0.6647 AS k,\n",
        "    (\n",
        "      SELECT\n",
        "        TOTAL_PARQUE\n",
        "      FROM\n",
        "        gold_proporcion_electricos_anio\n",
        "      WHERE\n",
        "        REGISTRO\n",
        "          = (\n",
        "            SELECT\n",
        "              MAX(REGISTRO)\n",
        "            FROM\n",
        "              gold_proporcion_electricos_anio\n",
        "          )\n",
        "    ) AS base_parque,\n",
        "    (\n",
        "      SELECT\n",
        "        MAX(REGISTRO)\n",
        "      FROM\n",
        "        gold_proporcion_electricos_anio\n",
        "    ) AS base_anio\n",
        "),\n",
        "historico AS (\n",
        "  SELECT\n",
        "    p.REGISTRO AS anio,\n",
        "    ROUND(p.PROPORCION_PORCENTAJE, 2) AS proporcion_pct,\n",
        "    p.TOTAL_ELECTRICOS AS total_electricos,\n",
        "    p.TOTAL_PARQUE AS total_parque,\n",
        "    'Histórico' AS tipo\n",
        "  FROM\n",
        "    gold_proporcion_electricos_anio p\n",
        "),\n",
        "proyeccion AS (\n",
        "  SELECT\n",
        "    y.anio,\n",
        "    ROUND(pr.L / (1.0 + EXP(-pr.k * (y.anio - pr.t0))), 2) AS proporcion_pct,\n",
        "    CAST(\n",
        "      ROUND(\n",
        "        pr.base_parque\n",
        "          * POWER(1.04, y.anio - pr.base_anio)\n",
        "          * (pr.L / (1.0 + EXP(-pr.k * (y.anio - pr.t0))))\n",
        "          / 100.0\n",
        "      ) AS INT\n",
        "    ) AS total_electricos,\n",
        "    CAST(ROUND(pr.base_parque * POWER(1.04, y.anio - pr.base_anio)) AS INT) AS total_parque,\n",
        "    'Proyección ML' AS tipo\n",
        "  FROM\n",
        "    (\n",
        "      SELECT\n",
        "        2027 AS anio\n",
        "      UNION ALL\n",
        "      SELECT\n",
        "        2028\n",
        "      UNION ALL\n",
        "      SELECT\n",
        "        2029\n",
        "      UNION ALL\n",
        "      SELECT\n",
        "        2030\n",
        "    ) y\n",
        "      CROSS JOIN params pr\n",
        ")\n",
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  historico\n",
        "UNION ALL\n",
        "SELECT\n",
        "  *\n",
        "FROM\n",
        "  proyeccion\n",
        "ORDER BY\n",
        "  anio"
      ]
    }
  ],
